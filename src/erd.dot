digraph ERD {
  graph [rankdir=LR, orientation=landscape, size="11.0,8.5!", ratio=fill, pad="0.3", nodesep="0.6", ranksep="1.0", splines=true];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", arrowsize=0.8];
  "crop" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>crop</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">crop_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">crop_name [NN]</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">scientific_name</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">crop_category</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">date_created</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">date_updated</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "crop_nutrient_requirement" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>crop_nutrient_requirement</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">requirement_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">crop_id [FK] [NN]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">stage_id [FK] [NN]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">n_requirement_kg_ha</TD><TD ALIGN="LEFT">DECIMAL(8,2)</TD></TR><TR><TD ALIGN="LEFT">p2o5_requirement_kg_ha</TD><TD ALIGN="LEFT">DECIMAL(8,2)</TD></TR><TR><TD ALIGN="LEFT">k2o_requirement_kg_ha</TD><TD ALIGN="LEFT">DECIMAL(8,2)</TD></TR><TR><TD ALIGN="LEFT">nutrient_priority</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">application_notes</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">date_created</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "crop_suitability" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>crop_suitability</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">suitability_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">crop_id [FK] [NN]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">optimal_ph_min</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">optimal_ph_max</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">s1_ph_min</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">s1_ph_max</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">s2_ph_min</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">s2_ph_max</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">s3_ph_min</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">s3_ph_max</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">n_ph_min</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">n_ph_max</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">suitability_notes</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">date_created</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "explanation_rule" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>explanation_rule</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">explanation_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">rule_type</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">triggered_condition</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">reason_template</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">recommendation_template</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">limitation_template</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">pathway_type</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">date_created</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "fertilizer_product" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>fertilizer_product</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">product_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">company_name [NN]</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">product_name [NN]</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">product_type</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">n_content_percent</TD><TD ALIGN="LEFT">DECIMAL(5,2)</TD></TR><TR><TD ALIGN="LEFT">p2o5_content_percent</TD><TD ALIGN="LEFT">DECIMAL(5,2)</TD></TR><TR><TD ALIGN="LEFT">k2o_content_percent</TD><TD ALIGN="LEFT">DECIMAL(5,2)</TD></TR><TR><TD ALIGN="LEFT">npk_analysis</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">registration_number</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">registration_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">expiry_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">date_created</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">date_updated</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "growth_stage" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>growth_stage</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">stage_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">crop_id [FK] [NN]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">stage_name [NN]</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">stage_order [NN]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">duration_days_min</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">duration_days_max</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">stage_description</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">date_created</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "growth_stage_rule" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>growth_stage_rule</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">rule_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">stage_id [FK] [NN]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">timing_note</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">application_note</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">nutrient_emphasis</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">application_interval_days</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">date_created</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "location_soil_profile" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>location_soil_profile</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">profile_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">barangay_location [NN]</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">soil_series</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">ph_min</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">ph_max</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">soil_texture</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">drainage</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">fertility_status</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">source_reference</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">confidence_level</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">date_created</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">date_updated</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "product_crop" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>product_crop</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">product_crop_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">product_id [FK] [NN]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">crop_id [FK] [NN]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">is_recommended</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">date_created</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "recommendation_log" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>recommendation_log</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">recommendation_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">crop_id [FK] [NN]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">stage_id [FK]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">product_id [FK]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">profile_id [FK]</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">input_ph</TD><TD ALIGN="LEFT">DECIMAL(3,1)</TD></TR><TR><TD ALIGN="LEFT">ph_source</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">pathway_type</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">recommendation_output</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">date_generated</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "validation_log" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="lightblue"><B>validation_log</B></TD></TR><TR><TD><B>Attribute</B></TD><TD><B>Type</B></TD></TR><TR><TD ALIGN="LEFT">log_id [PK]</TD><TD ALIGN="LEFT">SERIAL</TD></TR><TR><TD ALIGN="LEFT">table_name [NN]</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">record_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT">reviewed_item</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">expert_comment</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">decision</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">validator_name</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">review_date</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT">timestamp</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR></TABLE>>];
  "crop_nutrient_requirement" -> "crop" [label="crop_id -&gt; crop.crop_id", arrowhead="normal"];
  "crop_nutrient_requirement" -> "growth_stage" [label="stage_id -&gt; growth_stage.stage_id", arrowhead="normal"];
  "crop_suitability" -> "crop" [label="crop_id -&gt; crop.crop_id", arrowhead="normal"];
  "growth_stage" -> "crop" [label="crop_id -&gt; crop.crop_id", arrowhead="normal"];
  "growth_stage_rule" -> "growth_stage" [label="stage_id -&gt; growth_stage.stage_id", arrowhead="normal"];
  "product_crop" -> "fertilizer_product" [label="product_id -&gt; fertilizer_product.product_id", arrowhead="normal"];
  "product_crop" -> "crop" [label="crop_id -&gt; crop.crop_id", arrowhead="normal"];
  "recommendation_log" -> "crop" [label="crop_id -&gt; crop.crop_id", arrowhead="normal"];
  "recommendation_log" -> "growth_stage" [label="stage_id -&gt; growth_stage.stage_id", arrowhead="normal"];
  "recommendation_log" -> "fertilizer_product" [label="product_id -&gt; fertilizer_product.product_id", arrowhead="normal"];
  "recommendation_log" -> "location_soil_profile" [label="profile_id -&gt; location_soil_profile.profile_id", arrowhead="normal"];
}